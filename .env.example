# ===========================================
# TAILOREDTIME - ENVIRONMENT VARIABLES
# ===========================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git (it's in .gitignore)

# -------------------------------------------
# SUPABASE CONFIGURATION
# -------------------------------------------
# Get these from: https://app.supabase.com/project/_/settings/api
# 1. Create a new project at supabase.com
# 2. Go to Settings > API
# 3. Copy the Project URL and anon/public key

# ✅ SAFE: These can be in EXPO_PUBLIC (protected by RLS)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...your-anon-key

# ❌ NEVER add these to .env (server-side only in Edge Functions):
# SUPABASE_SERVICE_ROLE_KEY - This bypasses ALL RLS and should NEVER be in client code

# -------------------------------------------
# GOOGLE CALENDAR API (OAuth 2.0)
# -------------------------------------------
# Get these from: https://console.cloud.google.com/
# 1. Create a new project in Google Cloud Console
# 2. Enable Google Calendar API
# 3. Create OAuth 2.0 credentials (type: Android + iOS)
# 4. Add authorized redirect URI: com.adam.tailoredtime:/oauth

# ✅ SAFE: Client IDs are public (not secrets)
EXPO_PUBLIC_GOOGLE_CLIENT_ID_ANDROID=123456789-abcdefg.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_CLIENT_ID_IOS=123456789-hijklmn.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_CLIENT_ID_WEB=123456789-opqrstu.apps.googleusercontent.com

# ⚠️ WEB ONLY: Client Secret needed for web OAuth (localhost testing)
# For mobile (Android/iOS), PKCE is used so no secret needed
# Only add this if you're testing on web browser
EXPO_PUBLIC_GOOGLE_CLIENT_SECRET_WEB=GOCSPX-your-web-client-secret

# -------------------------------------------
# OPENAI API - DO NOT PUT HERE
# -------------------------------------------
# ❌ CRITICAL SECURITY ISSUE: Never put OpenAI API key in client code
# ❌ DO NOT USE: EXPO_PUBLIC_OPENAI_API_KEY=sk-proj-...
#
# ✅ CORRECT APPROACH:
# 1. Store OPENAI_API_KEY in Supabase Edge Function secrets:
#    supabase secrets set OPENAI_API_KEY=sk-proj-...
# 2. Call Edge Function from mobile app (lib/openai.ts)
# 3. Edge Function calls OpenAI API server-side
#
# See SECURITY.md "CRITICAL #2: API Key Exposure" for details

# -------------------------------------------
# OPTIONAL: ANALYTICS & MONITORING
# -------------------------------------------
# Add these later when you want to track usage

EXPO_PUBLIC_SENTRY_DSN=https://your-key@o0.ingest.sentry.io/0
EXPO_PUBLIC_POSTHOG_API_KEY=phc_your_key_here

# -------------------------------------------
# NOTES:
# -------------------------------------------
# ✅ Safe in EXPO_PUBLIC:
#    - Supabase URL and anon key (protected by RLS)
#    - Google OAuth Client IDs (not secrets)
#    - Public API endpoints
#    - Non-sensitive configuration
#
# ❌ NEVER in EXPO_PUBLIC:
#    - OpenAI API key (use Edge Function)
#    - Supabase service role key (bypasses RLS)
#    - Google Client Secret (use PKCE)
#    - Private keys, tokens, passwords
#    - Database credentials
#
# 📱 OAuth Redirect URIs:
#    - Android: com.adam.tailoredtime:/oauth
#    - iOS: com.adam.tailoredtime:/oauth
#
# 🔒 Token Storage:
#    - Auth tokens: SecureStore (encrypted)
#    - Non-sensitive data: AsyncStorage
#    - See lib/supabase.ts for implementation
#
# 📖 Security Reference:
#    - Read SECURITY.md before adding any new variables
#    - All EXPO_PUBLIC_* variables are embedded in app bundle
#    - Anyone can decompile your app and extract these values
